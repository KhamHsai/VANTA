APP_NAME=VANTA API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PREDICTION_CONFIDENCE_THRESHOLD=0.60
PREDICTION_MAX_UPLOAD_BYTES=10485760

# Database settings are shared with Docker Compose through the repository-root
# .env file. DATABASE_URL may be set here only when an explicit override is needed.
